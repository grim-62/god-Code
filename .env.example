# Browser URL. The app and API share a host, so keep the API path relative.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
VITE_API_BASE_URL=/api

# Host-based development services.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/god-code
REDIS_URL=redis://127.0.0.1:6379
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=GENERATE_ME

# Docker service addresses; do not change these to localhost.
DOCKER_MONGODB_URI=mongodb://mongo:27017/god-code
DOCKER_REDIS_URL=redis://app-redis:6379
DOCKER_JUDGE0_URL=http://judge0-server:2358

# Development origin. Set the exact public UI origin(s) for cross-origin deployments.
CORS_ORIGIN=http://localhost:5173

# Generate unique secrets with: npm run docker:init-env
JWT_SECRET=GENERATE_ME
JUDGE0_AUTHN_TOKEN=GENERATE_ME
JUDGE0_POSTGRES_PASSWORD=GENERATE_ME
JUDGE0_REDIS_PASSWORD=GENERATE_ME
SEED_USER_ID=
